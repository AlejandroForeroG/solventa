{
  "terms": {
    "es": {
      "purpose": "identity_verification",
      "textVersion": 1,
      "locale": "es-CO",
      "wording": "Autorizo a Solventa a procesar los archivos sintéticos seleccionados para una verificación KYC/AML simulada. El consentimiento y el avance son válidos por 24 horas para este intento. Puedo revocarlo; al revocar o vencer no se podrán evaluar ni reutilizar los pasos. Solo se conservan referencias, hashes e historial mínimo de auditoría, sin archivos personales ni constancia legal. El resultado no habilita por sí solo la contratación.",
      "wordingHash": "7b14f29427348c99cc27f345ff286ed1775fa7ee4f49a3ea1d315444ecf29d55",
      "validityHours": 24,
      "corpusVersion": "synthetic-identity.v1",
      "simulated": true
    },
    "en": {
      "purpose": "identity_verification",
      "textVersion": 1,
      "locale": "en-US",
      "wording": "I authorize Solventa to process the selected synthetic files for a simulated KYC/AML verification. Consent and progress are valid for 24 hours for this attempt. I may revoke consent; after revocation or expiry, steps cannot be evaluated or reused. Only references, hashes and minimal audit history are retained, without personal files or a legal certificate. The result does not itself grant permission to contract.",
      "wordingHash": "a7a4488e2052cbcd918fb6470ca56306f2f088ea766754e7387da8621e40f0c6",
      "validityHours": 24,
      "corpusVersion": "synthetic-identity.v1",
      "simulated": true
    }
  },
