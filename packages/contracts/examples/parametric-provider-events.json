{
  "description": "Agreed corpus for the simulated parametric provider, format version 1. Each case runs in CI through the provider adapter: a signed valid message becomes the occurrence the payment engine consumes and every other message is rejected. `sign` asks the test to seal the message with the synthetic financial key; a case without it carries its own signature. Whether an occurrence is covered or pays is decided later by the policy's coverage, not by this format.",
  "environment": "local",
  "cases": [
    {
      "name": "flight delay at the threshold",
      "sign": true,
      "schemaValid": true,
      "message": {
        "version": 1,
        "providerEventId": "40000000-0000-4000-8000-000000000001",
        "environment": "local",
        "synthetic": true,
        "observedAt": "2026-10-16T02:30:00.000Z",
        "policyId": "10000000-0000-4000-8000-000000000001",
        "reading": {
          "kind": "flight_delay",
          "flightReference": "30000000-0000-4000-8000-000000000001",
          "delayMinutes": 180
        }
      },
      "expected": {
        "status": "verified",
        "occurrence": {
          "eventId": "40000000-0000-4000-8000-000000000001",
          "occurredAt": "2026-10-16T02:30:00.000Z",
          "eventType": "flight.delay_verified",
          "payload": {
            "policyId": "10000000-0000-4000-8000-000000000001",
            "flightReference": "30000000-0000-4000-8000-000000000001",
            "delayMinutes": 180
          }
        }
      }
