{
  "consumer": {
    "name": "solventa-mobile"
  },
  "interactions": [
    {
      "description": "mobile device DELETE",
      "providerStates": [
        {
          "name": "a native session with its installation binding"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer synthetic.jwt.token"
        },
        "method": "DELETE",
        "path": "/api/v1/mobile/devices/00000000-0000-4000-8000-000000000003"
      },
      "response": {
        "body": {
          "device": {
            "id": "00000000-0000-4000-8000-000000000001",
            "installationId": "00000000-0000-4000-8000-000000000003",
            "status": "revoked"
          },
          "traceId": "00000000-0000-4000-8000-000000000002"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.traceId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "mobile device GET",
      "providerStates": [
        {
          "name": "a native session with its installation binding"
        }
      ],
      "request": {
        "headers": {
