          "Authorization": "Bearer synthetic.jwt.token"
        },
        "method": "GET",
        "path": "/api/v1/mobile/devices/00000000-0000-4000-8000-000000000003"
      },
      "response": {
        "body": {
          "device": {
            "id": "00000000-0000-4000-8000-000000000001",
            "installationId": "00000000-0000-4000-8000-000000000003",
            "status": "active"
          },
