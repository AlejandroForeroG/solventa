{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Synthetic assistance directory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "simulated",
    "providers"
  ],
  "properties": {
    "formatVersion": {
      "const": "synthetic-assistance-directory.v1"
    },
    "simulated": {
      "const": true
    },
    "providers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "city",
          "address",
          "phone",
          "hours",
          "coordinates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^demo-[a-z0-9-]{1,48}$"
          },
          "kind": {
            "enum": [
              "workshop",
              "expert",
              "roadside"
            ]
          },
          "name": {
            "$ref": "#/definitions/text"
          },
          "city": {
            "$ref": "#/definitions/text"
          },
          "address": {
            "$ref": "#/definitions/text"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+570{8}[0-9]{2}$"
          },
          "hours": {
            "$ref": "#/definitions/text"
          },
          "coordinates": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "latitude",
              "longitude"
            ],
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    }
  }
}
