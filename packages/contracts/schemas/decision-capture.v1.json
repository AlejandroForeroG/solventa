{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decision-capture.v1",
  "title": "Decision capture v1",
  "description": "What is persisted with every quote or underwriting decision so it can be reconstructed later. Evolve with optional fields only. Never carries PII.",
  "type": "object",
  "required": ["schemaVersion", "contractVersion", "correlationId", "inputs", "sources", "consent", "rule", "outcome"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "type": "string", "pattern": "^v[1-9][0-9]*$", "description": "API version that served the request." },
    "correlationId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "inputs": { "type": "object", "description": "Normalized minimum data used by the rule." },
    "sources": {
      "type": "array",
      "description": "External sources consulted. Empty when only minimum data was used.",
      "items": {
        "type": "object",
        "required": ["source", "capturedAt"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "capturedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+(Z|[+-][0-9]{2}:[0-9]{2})$" },
          "quality": { "type": "string", "minLength": 1 },
          "degraded": { "type": "boolean" }
        }
      }
    },
    "consent": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["verified", "not_required", "absent"] },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      },
      "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
      "then": { "required": ["id", "version"] }
    },
    "rule": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": { "type": "string", "minLength": 1 }
  }
}
