{
  "name": "solventa",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.21.1 <23"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev:web": "npm run dev --workspace @solventa/web",
    "dev:mobile": "npm run start --workspace @solventa/mobile",
    "dev:acquisition": "npm run dev --workspace @solventa/acquisition-risk",
    "dev:policy": "npm run dev --workspace @solventa/policy-claims-payments",
    "dev:identity": "npm run dev --workspace @solventa/identity-consent-ecosystem",
    "types": "npm run types --workspaces --if-present",
    "typecheck": "npm run types && npm run typecheck --workspaces --if-present",
    "lint": "oxlint apps backend packages --ignore-pattern **/worker-configuration.d.ts",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run test:git && npm run architecture:check && npm run test:architecture && npm run test:database && npm run test:environments && npm run lint && npm run typecheck && npm run build && npm run build:remote",
    "infra:up": "node infra/local.mjs up",
    "infra:down": "node infra/local.mjs down",
    "infra:verify": "node infra/database.mjs verify local",
    "dev:backend": "node infra/local.mjs dev",
    "architecture:check": "node tools/architecture.mjs",
    "test:architecture": "node --test tools/architecture.test.mjs",
    "build:dev": "npm run build:dev --workspaces --if-present",
    "test:infra": "node infra/smoke.mjs",
    "test:database": "node --test infra/database.test.mjs",
    "test:schema": "node infra/schema-smoke.mjs",
    "infra:local:schema-verify": "node infra/schema-verify.mjs local",
    "infra:dev:schema-verify": "node infra/schema-verify.mjs dev",
    "infra:staging:schema-verify": "node infra/schema-verify.mjs staging",
    "infra:prod:schema-verify": "node infra/schema-verify.mjs prod",
    "infra:dev:up": "node infra/remote.mjs up dev",
    "deploy:dev": "npm run build --workspace @solventa/web && node infra/remote.mjs deploy dev",
    "infra:dev:verify": "node infra/remote.mjs verify dev",
    "test:environments": "node --test infra/environments.test.mjs infra/ci.test.mjs infra/deployment.test.mjs",
    "build:remote": "node infra/build-remote.mjs",
    "infra:staging:up": "node infra/remote.mjs up staging",
    "deploy:staging": "npm run build --workspace @solventa/web && node infra/remote.mjs deploy staging",
    "infra:staging:verify": "node infra/remote.mjs verify staging",
    "infra:prod:up": "node infra/remote.mjs up prod",
    "deploy:prod": "npm run build --workspace @solventa/web && node infra/remote.mjs deploy prod",
    "infra:prod:verify": "node infra/remote.mjs verify prod",
    "prepare": "node tools/install-hooks.mjs",
    "test:git": "node --test tools/git-policy.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pg": "8.23.1",
    "oxlint": "^1.81.0",
    "pg": "8.23.1",
    "typescript": "~6.0.3",
    "wrangler": "4.146.0"
  }
}
