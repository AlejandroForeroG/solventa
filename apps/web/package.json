{
  "name": "@solventa/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.worker.json",
    "types": "wrangler types --env-interface WebEnv --strict-vars=false -c wrangler.jsonc -c ../../backend/acquisition-risk/wrangler.jsonc -c ../../backend/identity-consent-ecosystem/wrangler.jsonc -c ../../backend/policy-claims-payments/wrangler.jsonc",
    "build:dev": "npm run build && wrangler deploy --env dev --dry-run --outdir worker-dist"
  },
  "dependencies": {
    "@solventa/assets": "0.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
