{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "803fd559877aae8f638140610f106857",
  "name": "solventa-web-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/internal/*",
      "/api/*",
      "/auth/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    },
    "redact_query_string": true
  },
  "vars": {
    "APP_ENV": "local"
  },
  "services": [
    {
      "binding": "ACQUISITION",
      "service": "solventa-acquisition-risk-local"
    },
    {
      "binding": "IDENTITY",
      "service": "solventa-identity-consent-ecosystem-local"
    },
    {
      "binding": "POLICY",
      "service": "solventa-policy-claims-payments-local"
    }
  ],
  "env": {
    "dev": {
      "name": "solventa-web-dev",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "dev"
      },
      "services": [
        {
          "binding": "ACQUISITION",
          "service": "solventa-acquisition-risk-dev"
        },
        {
          "binding": "IDENTITY",
          "service": "solventa-identity-consent-ecosystem-dev"
        },
        {
          "binding": "POLICY",
          "service": "solventa-policy-claims-payments-dev"
        }
      ],
      "secrets": {
        "required": [
          "DEV_INFRA_TOKEN"
        ]
      }
    },
    "staging": {
      "name": "solventa-web-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging"
      },
      "services": [
        {
          "binding": "ACQUISITION",
          "service": "solventa-acquisition-risk-staging"
        },
        {
          "binding": "IDENTITY",
          "service": "solventa-identity-consent-ecosystem-staging"
        },
        {
          "binding": "POLICY",
          "service": "solventa-policy-claims-payments-staging"
        }
      ],
      "secrets": {
        "required": [
          "DEV_INFRA_TOKEN"
        ]
      }
    },
    "prod": {
      "name": "solventa-web-prod",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "prod"
      },
      "services": [
        {
          "binding": "ACQUISITION",
          "service": "solventa-acquisition-risk-prod"
        },
        {
          "binding": "IDENTITY",
          "service": "solventa-identity-consent-ecosystem-prod"
        },
        {
          "binding": "POLICY",
          "service": "solventa-policy-claims-payments-prod"
        }
      ],
      "secrets": {
        "required": [
          "DEV_INFRA_TOKEN"
        ]
      }
    }
  },
  "secrets": {
    "required": [
      "DEV_INFRA_TOKEN"
    ]
  }
}
