{
  "expo": {
    "name": "Solventa",
    "slug": "solventa",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "solventa",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B6B5F",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6B5F",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
