{
  "name": "@solventa/acquisition-risk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 -c wrangler.local.json -c ../identity-consent-ecosystem/wrangler.local.json",
    "types": "wrangler types --strict-vars=false -c wrangler.jsonc -c ../identity-consent-ecosystem/wrangler.jsonc --env-interface AcquisitionEnv",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:dev": "wrangler deploy --env dev --dry-run --outdir dist/dev"
  },
  "dependencies": {
    "hono": "4.13.12",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
