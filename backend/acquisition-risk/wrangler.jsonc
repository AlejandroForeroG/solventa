{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "solventa-acquisition-risk-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "account_id": "803fd559877aae8f638140610f106857",
  "vars": {
    "APP_ENV": "local"
  },
  "hyperdrive": [
    {
      "binding": "ACQUISITION_DB",
      "id": "00000000000000000000000000000000"
    }
  ],
  "env": {
    "dev": {
      "name": "solventa-acquisition-risk-dev",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "dev"
      },
      "hyperdrive": [
        {
          "binding": "ACQUISITION_DB",
          "id": "e5a14ab9ea0042cab2769448f8b5495a"
        }
      ],
      "services": [
        {
          "binding": "IDENTITY_SERVICE",
          "service": "solventa-identity-consent-ecosystem-dev"
        }
      ]
    }
  },
  "services": [
    {
      "binding": "IDENTITY_SERVICE",
      "service": "solventa-identity-consent-ecosystem-local"
    }
  ]
}
