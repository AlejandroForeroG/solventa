{
  "name": "@solventa/identity-consent-ecosystem",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8789 -c wrangler.local.json",
    "types": "wrangler types --strict-vars=false --env-interface IdentityEnv",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:dev": "wrangler deploy --env dev --dry-run --outdir dist/dev"
  },
  "dependencies": {
    "@workos-inc/node": "^11.0.0",
    "hono": "4.13.12",
    "jose": "^6.2.12",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
