{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "solventa-policy-claims-payments-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "account_id": "803fd559877aae8f638140610f106857",
  "vars": {
    "APP_ENV": "local",
    "FINANCIAL_PROVIDER_MODE": "mock"
  },
  "hyperdrive": [
    {
      "binding": "POLICY_DB",
      "id": "00000000000000000000000000000000"
    }
  ],
  "env": {
    "dev": {
      "name": "solventa-policy-claims-payments-dev",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "dev",
        "FINANCIAL_PROVIDER_MODE": "mock"
      },
      "hyperdrive": [
        {
          "binding": "POLICY_DB",
          "id": "2e62599bd8ea401092bd70c45b124af2"
        }
      ],
      "services": [
        {
          "binding": "IDENTITY_SERVICE",
          "service": "solventa-identity-consent-ecosystem-dev"
        }
      ],
      "queues": {
        "consumers": [
          {
            "max_retries": 5,
            "max_batch_size": 10,
            "max_batch_timeout": 0,
            "dead_letter_queue": "solventa-financial-events-dlq-dev",
            "queue": "solventa-financial-events-dev"
          }
        ]
      }
    },
    "staging": {
      "name": "solventa-policy-claims-payments-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "FINANCIAL_PROVIDER_MODE": "mock"
      },
      "hyperdrive": [
        {
          "binding": "POLICY_DB",
          "id": "9eab620dc2654d4c823128fb884f0664"
        }
      ],
      "services": [
        {
          "binding": "IDENTITY_SERVICE",
          "service": "solventa-identity-consent-ecosystem-staging"
        }
      ],
      "queues": {
        "consumers": [
          {
            "max_retries": 5,
            "max_batch_size": 10,
            "max_batch_timeout": 0,
            "dead_letter_queue": "solventa-financial-events-dlq-staging",
            "queue": "solventa-financial-events-staging"
          }
        ]
      }
    },
    "prod": {
      "name": "solventa-policy-claims-payments-prod",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "prod",
        "FINANCIAL_PROVIDER_MODE": "disabled"
      },
      "hyperdrive": [
        {
          "binding": "POLICY_DB",
          "id": "0821ea6b041445ce976921a4c28f07b5"
        }
      ],
      "services": [
        {
          "binding": "IDENTITY_SERVICE",
          "service": "solventa-identity-consent-ecosystem-prod"
        }
      ],
      "queues": {
        "consumers": []
      }
    }
  },
  "services": [
    {
      "binding": "IDENTITY_SERVICE",
      "service": "solventa-identity-consent-ecosystem-local"
    }
  ],
  "queues": {
    "consumers": [
      {
        "max_retries": 5,
        "max_batch_size": 10,
            "max_batch_timeout": 0,
        "dead_letter_queue": "solventa-financial-events-dlq-local",
        "queue": "solventa-financial-events-local"
      }
    ]
  }
}
