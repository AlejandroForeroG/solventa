meta {
  name: Public mobile configuration
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/api/v1/mobile/config
  body: none
  auth: none
}
tests {
  test("Native connection contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("cache-control")).to.equal("no-store");
    const body = res.getBody();
    expect(body.traceId).to.equal(res.getHeader("x-trace-id"));
    expect(body).to.have.property("clientId");
  });
}
