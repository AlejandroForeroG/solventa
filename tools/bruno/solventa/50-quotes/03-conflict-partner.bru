meta {
  name: Reject changed request with reused key
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/api/v1/quotes
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
  Idempotency-Key: {{quoteIdempotencyKey}}
  X-Trace-Id: 50000000-0000-4000-8000-000000000003
}
body:json {
  {
    "product": "vida_hipotecario",
    "customer": {
      "fullName": "Synthetic Bruno Customer",
      "documentType": "CC",
      "documentNumber": "1098765432",
      "birthDate": "1992-03-14",
      "city": "Bogotá D.C."
    },
    "credit": {
      "partnerCreditId": "BRUNO-SYNTHETIC-1",
      "amount": 1000000,
      "termMonths": 180
    }
  }
}
script:pre-request {
  if (!bru.getVar("accessToken") || bru.getVar("accessTokenBaseUrl") !== bru.getEnvVar("baseUrl")) throw new Error("Issue a partner token for this environment first.");
  if (!bru.getEnvVar("quoteIdempotencyKey")) throw new Error("Keep the local quoteIdempotencyKey from the first request.");
}
tests {
  test("Changed body with the same actor and key conflicts", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.equal("idempotency_key_reused");
  });
}
