meta {
  name: Partner with invalid token
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/api/v1/access/partner
  body: none
  auth: none
}
headers {
  X-Trace-Id: 7f3c2a9e-1b4d-4c8e-9a52-0d6e8f1a3b47
  Authorization: Bearer invalid-synthetic-token
}
tests {
  test("Access contract", function () {
    expect(res.getStatus()).to.equal(401);
    const body = res.getBody();
    expect(body.traceId).to.equal("7f3c2a9e-1b4d-4c8e-9a52-0d6e8f1a3b47");
    expect(res.getHeader("x-trace-id")).to.equal(body.traceId);
    expect(res.getHeader("cache-control")).to.equal("no-store");
    expect(body.error).to.equal("unauthorized");
  });
}
