meta {
  name: Web rechaza Bearer
  type: http
  seq: 5
}
get {
  url: {{baseUrl}}/api/v1/access/web
  body: none
  auth: none
}
headers {
  Authorization: Bearer invalid-synthetic-token
  X-Trace-Id: 7f3c2a9e-1b4d-4c8e-9a52-0d6e8f1a3b47
}
tests {
  test("Credenciales no mezcladas", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("invalid_request");
    expect(res.getBody().traceId).to.equal("7f3c2a9e-1b4d-4c8e-9a52-0d6e8f1a3b47");
    expect(res.getHeader("x-trace-id")).to.equal(res.getBody().traceId);
    expect(res.getHeader("cache-control")).to.equal("no-store");
  });
}
